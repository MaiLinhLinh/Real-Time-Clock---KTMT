  73   1        i2c_write(cmd_l|0x0C);   // 1 1 0 0
  74   1        i2c_ACK();
  75   1        delay_ms(5);
  76   1        i2c_write(cmd_l|0x08);
  77   1        i2c_ACK();
  78   1        delay_ms(5);
  79   1        i2c_stop();
  80   1      }

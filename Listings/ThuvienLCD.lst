 150          void LCD_Send_Number(int number)
 151          {
 152   1        if(number <= 9)
 153   1        {
 154   2          LCD_Send_Data(number + 48);
 155   2        }
 156   1        else if(number > 9 && number < 100)
 157   1        {
 158   2          LCD_Send_Data(number/10 + 48);
 159   2          LCD_Send_Data(number%10 + 48);
 160   2        }
 161   1        else if(number > 99 && number < 1000)
 162   1        {
 163   2          LCD_Send_Data(number/100 + 48);
 164   2          LCD_Send_Data(number/10%10 + 48);
 165   2          LCD_Send_Data(number%10 + 48);
 166   2        }
 167   1        else if(number > 999 && number < 10000)
 168   1        {
 169   2          LCD_Send_Data(number/1000 + 48);
 170   2          LCD_Send_Data(number/100%10 + 48);
 171   2          LCD_Send_Data(number/10%10 + 48);
 172   2          LCD_Send_Data(number%10 + 48);
 173   2        }
 174   1      }

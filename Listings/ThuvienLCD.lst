 136          void LCD_Gotoxy (int col, int row)
 137          {
 138   1        int pos_Addr;
 139   1        if(row == 1) 
 140   1        {
 141   2          pos_Addr = 0x80 + row - 2 + col;
 142   2        }
 143   1        else

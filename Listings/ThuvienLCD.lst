  57          void lcd_send_cmd(unsigned char cmd)
  58          {
  59   1        unsigned char cmd_l,cmd_u;
  60   1        
  61   1        cmd_l=(cmd<<4)&0xf0;
  62   1        cmd_u=(cmd &0xf0);
  63   1        
  64   1        i2c_start();       //BL EN RW RS 1 1 0 0

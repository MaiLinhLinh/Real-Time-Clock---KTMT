 117          bit DS1307_Read_Time(unsigned int * hour, unsigned int * minute, unsigned int * second)
 118          {
 119   1        unsigned int h_tmp, m_tmp, s_tmp, *mode;
 120   1        bit am_pm;
 121   1        I2C2_Start();
 122   1        I2C2_Write(0xD0); 
 123   1        I2C2_Write(0x00);
 124   1        I2C2_Start(); 
 125   1        I2C2_Write(0xD1); 
 126   1        s_tmp = I2C2_Read(1);
 127   1        m_tmp = I2C2_Read(1);
 128   1        h_tmp = I2C2_Read(0);
 129   1        I2C2_Stop();
 130   1      
 131   1        s_tmp &= 0x7F;
 132   1        *second = (s_tmp>>4)*10+(s_tmp&0x0F);
 133   1        m_tmp &= 0x7F;
 134   1        *minute = (m_tmp>>4)*10+(m_tmp&0x0F);
 135   1      
 136   1        if(h_tmp & 0x40)    // Mode 12h
 137   1        {
 138   2          *mode = 12;
 139   2          if(h_tmp & 0x20)
 140   2          {
 141   3            am_pm = 1;    // PM
 142   3          }
 143   2          else
 144   2          {
 145   3            am_pm = 0;
 146   3          }
 147   2          h_tmp &= 0x1F;
 148   2          *hour = (h_tmp>>4)*10+(h_tmp&0x0F);
 149   2        }
 150   1        else
 151   1        {
 152   2          *mode = 24;
 153   2          h_tmp &= 0x3F;
 154   2          *hour = (h_tmp>>4)*10+(h_tmp&0x0F);
 155   2          if(*hour<12)
 156   2          {
 157   3            am_pm = 0;    // AM
 158   3          }
 159   2          else
 160   2          {
 161   3            am_pm = 1;
 162   3          }
 163   2        } 
 164   1        return am_pm;
 165   1      }
